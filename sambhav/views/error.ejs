<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error • Sambhav Security Lab</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <div class="page-shell">
        <nav class="navbar">
            <div class="badge">⚠️ Something went wrong</div>
            <div class="nav-links">
                <a href="/">Home</a>
                <a href="/dashboard">Dashboard</a>
                <a href="/blackbox">Black Box</a>
            </div>
        </nav>

        <section class="hero-card" style="margin-bottom:32px;">
            <h1 class="hero-title" style="font-size:2.2rem;">Error Encountered</h1>
            <p class="hero-subtitle">The lab couldn’t process your request.</p>
            <p><%= message %></p>
        </section>

        <section class="alert">
            <h3>🔁 Try Again</h3>
            <p>Double-check the URL or return to the <a href="/dashboard">dashboard</a> to continue your training mission.</p>
        </section>
    </div>
</body>
</html>
